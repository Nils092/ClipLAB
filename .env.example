# ---------- Allgemein ----------
PORT=3000
# Öffentliche HTTPS-Adresse des Servers (ohne / am Ende).
# Instagram lädt die Videos von hier herunter, TikTok und Meta leiten nach dem Login hierher zurück.
PUBLIC_BASE_URL=https://clips.example.de
# Langer Zufallswert, z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Damit werden Sitzungen signiert und die Zugangstokens der Accounts verschlüsselt. Nicht mehr ändern!
APP_SECRET=
# Code, den neue Clipper bei der Registrierung eingeben müssen (leer = Registrierung gesperrt)
INVITE_CODE=
# Ordner für Datenbank und Videos
DATA_DIR=./data
# Videos nach so vielen Tagen löschen, wenn alle Posts erledigt sind
RETENTION_DAYS=14

# ---------- TikTok (developers.tiktok.com) ----------
# Produkte: Login Kit + Content Posting API (Direct Post aktivieren)
# Redirect URI im Portal: ${PUBLIC_BASE_URL}/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Solange die App nicht auditiert ist, sind Direkt-Posts nur privat sichtbar.
# true = Server erzwingt Entwurf-Modus (Inbox), bis du auf false stellst.
TIKTOK_UNAUDITED=true

# ---------- Instagram (developers.facebook.com) ----------
# Produkt: "Instagram API with Instagram Login", Berechtigungen:
# instagram_business_basic, instagram_business_content_publish
# Redirect URI: ${PUBLIC_BASE_URL}/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v21.0
# Neue Meta-Apps nutzen "Unified Login": dann hier die Konfigurations-ID eintragen
# (App-ID/Geheimcode oben = die der Meta-App unter App-Einstellungen → Allgemeines)
INSTAGRAM_CONFIG_ID=

# ---------- Clipping-App (optional) ----------
# Basis-URL der App deines Freundes, sobald sie POST /api/submissions anbietet
CLIPPING_APP_URL=

# ---------- Auto-Clips ----------
# Claude findet die lustigsten Stellen und schreibt Titel, Caption und Hashtags (console.anthropic.com → API Keys).
# Leer = einfache Regeln (Lachen + Lautstärke).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Schnelle Transkription in der Cloud (console.groq.com → API Keys): 18 Min. Video in ca. 15 Sekunden, ca. 4 Cent pro Stunde.
# Leer = Whisper auf dem eigenen Server (kostenlos, dauert etwa so lange wie das Video).
GROQ_API_KEY=
# Whisper-Modell für die Untertitel: base (schnell), small (gut, Standard), medium (genauer, langsam)
WHISPER_MODEL=small
# Sprache: auto, de, en, …
WHISPER_LANGUAGE=auto
# Maximale Größe für hochgeladenes Rohmaterial in MB
MAX_PROJECT_MB=4000

# ---------- E-Mail (Bestätigung neuer Clipper) ----------
# Ist ein Postfach eingetragen, kann sich jeder registrieren und muss die E-Mail bestätigen (kein Code nötig).
# IONOS: smtp.ionos.de, Port 465, Benutzer = komplette Mailadresse, Passwort = Passwort des Postfachs
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ClipLab <info@imakio.de>
# Registrierung: leer = automatisch (mail, wenn Postfach eingerichtet, sonst invite), oder mail | invite | closed
REGISTRATION=
